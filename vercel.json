{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/youtube/shorts", "destination": "/api/shorts" },
    { "source": "/api/youtube/live", "destination": "/api/live" },
    { "source": "/api/youtube/videos", "destination": "/api/videos" },
    { "source": "/api/youtube/playlists", "destination": "/api/playlists" },
    { "source": "/api/youtube/featured-channels", "destination": "/api/featured-channels" }
  ]
}
